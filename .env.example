# اتصال به PostgreSQL (با docker compose بالا می‌آید)
DATABASE_URL="postgresql://sarva:sarva_secret@localhost:5432/sarva_shop?schema=public"
DIRECT_DATABASE_URL="postgresql://sarva:sarva_secret@localhost:5432/sarva_shop?schema=public"

# کلید امضای JWT — در محصول حتماً یک مقدار تصادفی بلند بگذارید
AUTH_SECRET="change-me-to-a-long-random-string-please-32chars"

# نشست
SESSION_COOKIE_NAME="sarva_session"
SESSION_MAX_AGE=2592000

# اطلاعات ادمین پیش‌فرض (فقط برای seed اولیه)
SEED_ADMIN_EMAIL="admin@sarva.shop"
SEED_ADMIN_PASSWORD="Admin@12345"

# نام فروشگاه
NEXT_PUBLIC_SITE_NAME="سَروا"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# آماده‌سازی خودکار دیتابیس در اولین اجرا (ساخت جدول‌ها + داده‌ی نمونه).
# مقدار 0 آن را غیرفعال می‌کند.
AUTO_DB_SETUP=1
